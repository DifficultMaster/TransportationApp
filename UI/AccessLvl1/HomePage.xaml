<Page x:Class="AppClient.UI.AccessLvl1.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AppClient.UI.AccessLvl1"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1770"
      Title="HomePage" Background="Transparent" Unloaded="Page_Unloaded">
    <Border Background="#C1C7D9" CornerRadius="30,0,0,30">
        <Grid>
            <Label x:Name="LivetimeLabel" Content="00:00" HorizontalAlignment="Right" Margin="0,-900,80,0" VerticalAlignment="Center" FontSize="60" FontFamily="Noto Sans JP Black" Background="{x:Null}" Foreground="#0F398C"/>
            <Label Content="Вітаємо," HorizontalAlignment="Left" Margin="100,-900,0,0" VerticalAlignment="Center" FontSize="50" FontFamily="Noto Sans JP Black" Background="{x:Null}" Foreground="#0F398C"/>
            <Label x:Name="WelcomeLabel" Content="Користувач!" HorizontalAlignment="Left" Margin="200,-750,0,0" VerticalAlignment="Center" FontSize="60" FontFamily="Noto Sans JP Black" Background="{x:Null}" Foreground="#0F398C"/>
            <Label Content="Рівень доступу: " HorizontalAlignment="Left" Margin="100,-550,0,0" VerticalAlignment="Center" FontSize="40" FontFamily="Noto Sans JP" Background="{x:Null}" Foreground="#0F398C"/>
            <Label x:Name="AccessLevelLabel" Content="" HorizontalAlignment="Left" Margin="420,-550,0,0" VerticalAlignment="Center" FontSize="40" FontFamily="Noto Sans JP Black" Background="{x:Null}" Foreground="#0F398C"/>
            <Grid x:Name="InformationGrid">
                <Border Background="#0F398C" CornerRadius="20" Margin="60,560,945,40">
                    <Grid>
                        <Label Content="Моя інформація" HorizontalAlignment="Left" Margin="50,-400,0,0" VerticalAlignment="Center" FontSize="30" FontFamily="Noto Sans JP" Background="{x:Null}" Foreground="#C1C7D9"/>
                        <Label Content="Ім'я:" HorizontalAlignment="Left" Margin="50,-200,0,0" VerticalAlignment="Center" FontSize="30" FontFamily="Noto Sans JP Light" Background="{x:Null}" Foreground="#C1C7D9"/>
                        <Label x:Name="FirstnameLabel" Content="" HorizontalAlignment="Left" Margin="130,-200,0,0" VerticalAlignment="Center" FontSize="30" FontFamily="Noto Sans JP DemiLight" Background="{x:Null}" Foreground="#C1C7D9"/>
                        <Label Content="Прізвище:" HorizontalAlignment="Left" Margin="50,-100,0,0" VerticalAlignment="Center" FontSize="30" FontFamily="Noto Sans JP Light" Background="{x:Null}" Foreground="#C1C7D9"/>
                        <Label x:Name="SurnameLabel" Content="" HorizontalAlignment="Left" Margin="210,-100,0,0" VerticalAlignment="Center" FontSize="30" FontFamily="Noto Sans JP DemiLight" Background="{x:Null}" Foreground="#C1C7D9"/>
                        <Label Content="По-батькові:" HorizontalAlignment="Left" Margin="50,0,0,0" VerticalAlignment="Center" FontSize="30" FontFamily="Noto Sans JP Light" Background="{x:Null}" Foreground="#C1C7D9"/>
                        <Label x:Name="LastnameLabel" Content="" HorizontalAlignment="Left" Margin="240,0,0,0" VerticalAlignment="Center" FontSize="30" FontFamily="Noto Sans JP DemiLight" Background="{x:Null}" Foreground="#C1C7D9"/>
                        <Label Content="Контактний номер:" HorizontalAlignment="Left" Margin="50,200,0,0" VerticalAlignment="Center" FontSize="30" FontFamily="Noto Sans JP Light" Background="{x:Null}" Foreground="#C1C7D9"/>
                        <TextBox x:Name="ContactNumberTextbox" HorizontalAlignment="Center" Margin="230,200,0,0" TextWrapping="Wrap" VerticalAlignment="Center" Width="300" Height="38" FontSize="14" FontFamily="Noto Sans JP Medium" AllowDrop="False" Text="+380" IsEnabled="False" Style="{StaticResource CustomTextboxStyle}" LostFocus="ContactNumberTextbox_LostFocus" KeyDown="ContactNumberTextbox_KeyDown" MaxLength="13" MaxLines="1"/>
                        <Button x:Name="EditContactNumberButton" HorizontalAlignment="Left" Height="38" Margin="660,200,0,0" VerticalAlignment="Center" Width="38" Style="{StaticResource SmoothActiveButtonStyle}" Click="EditButton_Click">
                            <Button.Background>
                                <ImageBrush ImageSource="/UI/Resources/Images/editIcon.png"/>
                            </Button.Background>
                        </Button>
                        <Label Content="Пароль:" HorizontalAlignment="Left" Margin="50,300,0,0" VerticalAlignment="Center" FontSize="30" FontFamily="Noto Sans JP Light" Background="{x:Null}" Foreground="#C1C7D9"/>
                        <PasswordBox x:Name="PasswordTextbox" HorizontalAlignment="Center" Margin="230,300,0,0" VerticalAlignment="Center" Width="300" Height="38" FontSize="14" FontFamily="Noto Sans JP Medium" AllowDrop="False" IsEnabled="False" LostFocus="ContactNumberTextbox_LostFocus" KeyDown="ContactNumberTextbox_KeyDown" MaxLength="13"/>
                        <Button x:Name="EditPasswordButton" HorizontalAlignment="Left" Height="38" Margin="660,300,0,0" VerticalAlignment="Center" Width="38" Style="{StaticResource SmoothActiveButtonStyle}" Click="EditButton_Click">
                            <Button.Background>
                                <ImageBrush ImageSource="/UI/Resources/Images/editIcon.png"/>
                            </Button.Background>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
            <Grid x:Name="DepotGrid" Visibility="Collapsed">
                <Border Background="#0F398C" CornerRadius="20" Margin="945,560,60,40">
                    <Grid>
                        <Label Content="Моє депо" HorizontalAlignment="Left" Margin="50,-400,0,0" VerticalAlignment="Center" FontSize="30" FontFamily="Noto Sans JP" Background="{x:Null}" Foreground="#C1C7D9"/>
                        <Label Content="Назва:" HorizontalAlignment="Left" Margin="50,-200,0,0" VerticalAlignment="Center" FontSize="30" FontFamily="Noto Sans JP Light" Background="{x:Null}" Foreground="#C1C7D9"/>
                        <Label x:Name="NameLabel" Content="" HorizontalAlignment="Left" Margin="160,-200,0,0" VerticalAlignment="Center" FontSize="30" FontFamily="Noto Sans JP DemiLight" Background="{x:Null}" Foreground="#C1C7D9"/>
                        <Label x:Name="AddressInformationLabel" Content="Адреса:" HorizontalAlignment="Left" Margin="50,-100,0,0" VerticalAlignment="Center" FontSize="30" FontFamily="Noto Sans JP Light" Background="{x:Null}" Foreground="#C1C7D9"/>
                        <Label x:Name="AddressLabel" Content="" HorizontalAlignment="Left" Margin="176,-100,0,0" VerticalAlignment="Center" FontSize="30" FontFamily="Noto Sans JP DemiLight" Background="{x:Null}" Foreground="#C1C7D9"/>
                        <Label Content="Тип:" HorizontalAlignment="Left" Margin="50,100,0,0" VerticalAlignment="Center" FontSize="30" FontFamily="Noto Sans JP Light" Background="{x:Null}" Foreground="#C1C7D9"/>
                        <Label x:Name="TypeLabel" Content="" HorizontalAlignment="Left" Margin="130,100,0,0" VerticalAlignment="Center" FontSize="30" FontFamily="Noto Sans JP DemiLight" Background="{x:Null}" Foreground="#C1C7D9"/>
                        <Label Content="Оператор:" HorizontalAlignment="Left" Margin="50,200,0,0" VerticalAlignment="Center" FontSize="30" FontFamily="Noto Sans JP Light" Background="{x:Null}" Foreground="#C1C7D9"/>
                        <Label x:Name="OperatorLabel" Content="" HorizontalAlignment="Left" Margin="210,200,0,0" VerticalAlignment="Center" FontSize="30" FontFamily="Noto Sans JP DemiLight" Background="{x:Null}" Foreground="#C1C7D9"/>
                        <Label x:Name="ContactNumberInformationLabel" Content="Контактний номер:" HorizontalAlignment="Left" Margin="50,300,0,0" VerticalAlignment="Center" FontSize="30" FontFamily="Noto Sans JP Light" Background="{x:Null}" Foreground="#C1C7D9"/>
                        <Label x:Name="ContactNumberLabel" Content="" HorizontalAlignment="Left" Margin="340,300,0,0" VerticalAlignment="Center" FontSize="30" FontFamily="Noto Sans JP DemiLight" Background="{x:Null}" Foreground="#C1C7D9"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Page>
