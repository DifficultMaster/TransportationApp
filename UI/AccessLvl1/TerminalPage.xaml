<Page x:Name="TerminalPage1" x:Class="AppClient.UI.TerminalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AppClient.UI"
      mc:Ignorable="d" 
      d:DesignHeight="960" d:DesignWidth="600"
      Title="TerminalPage" Background="{StaticResource PrimaryDarkBlue}"     
      PreviewKeyDown="TerminalPage_PreviewKeyDown">

    <Grid x:Name="TerminalGrid">
        <Button x:Name="ExitButton" HorizontalAlignment="Left" Height="22" Margin="8,8,0,0" VerticalAlignment="Top" Width="22" Style="{StaticResource SmoothActiveButtonStyle}" Click="ExitButton_Click">
            <Button.Background>
                <ImageBrush ImageSource="/UI/Resources/Images/exitIcon.png"/>
            </Button.Background>
        </Button>
        <Image x:Name="BackgroundImage" HorizontalAlignment="Center" Height="590" VerticalAlignment="Center" Width="442" Source="/UI/Resources/Images/Backgrounds/terminal.png" Margin="0,-376,0,0"/>
        <Label x:Name="MessagePrimaryLabel" Content="Прикладіть картку" HorizontalAlignment="Center" Margin="0,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBackground}" FontFamily="Noto Sans JP Black" FontSize="36" />
        <Label x:Name="MessageSecondaryLabel" Content="До сплати 0 грн" HorizontalAlignment="Center" Margin="0,150,0,0" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBackground}" FontFamily="Noto Sans JP Medium" FontSize="27" />
        <Label x:Name="MessageTertiaryLabel" Content="ОПЛАТА УСПІШНА" HorizontalAlignment="Center" Margin="0,750,0,0" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBackground}" FontFamily="Noto Sans JP Black" FontSize="36" Visibility="Hidden" />
        <PasswordBox x:Name="PasswordTextbox" HorizontalAlignment="Center" Margin="0,450,0,0" VerticalAlignment="Center" Width="300" Height="38" FontSize="14" FontFamily="Noto Sans JP Medium" AllowDrop="False" Style="{StaticResource CustomPasswordboxStyle}" Visibility="Hidden" PasswordChanged="PasswordTextbox_PasswordChanged"/>
        <Button x:Name="LogoutButton" Content="Вийти" HorizontalAlignment="Center" Margin="0,600,0,0" VerticalAlignment="Center" Width="136" Height="46" FontSize="21" FontFamily="Noto Sans JP Medium" Background="#FFC1C7D9" Foreground="#FF4679A6" Style="{StaticResource SmoothActiveButtonStyle}" Click="LogoutButton_Click" IsEnabled="True" Visibility="Hidden"/>
    </Grid>
</Page>
