            <Grid.Clip>
                <RectangleGeometry RadiusX="20" RadiusY="20" Rect="0,0,465,450"/>
            </Grid.Clip>
            <Label Content="??????? ???? ????? ??????:" HorizontalAlignment="Center" Margin="0,-300,0,0" VerticalAlignment="Center" FontSize="27" FontFamily="Noto Sans JP Medium" Background="{x:Null}" Foreground="#FFC1C7D9"/>
            <Label Content="?????? ??????" HorizontalAlignment="Center" Margin="-180,-135,0,0" VerticalAlignment="Center" FontSize="16" FontFamily="Noto Sans JP Light" Background="{x:Null}" Foreground="#FFC1C7D9"/>
            <PasswordBox x:Name="OldPasswordTextbox" HorizontalAlignment="Center" Margin="0,-75,0,0" VerticalAlignment="Center" Width="300" Height="38" FontSize="14" FontFamily="Noto Sans JP Medium" AllowDrop="False" Style="{StaticResource CustomPasswordboxStyle}" LostFocus="Textbox_LostFocus"/>
            <Label Content="????? ??????" HorizontalAlignment="Center" Margin="-190,90,0,0" VerticalAlignment="Center" FontSize="16" FontFamily="Noto Sans JP Light" Background="{x:Null}" Foreground="#FFC1C7D9"/>
            <PasswordBox x:Name="NewPasswordTextbox" HorizontalAlignment="Center" Margin="0,150,0,0" VerticalAlignment="Center" Width="300" Height="38" FontSize="14" FontFamily="Noto Sans JP Medium" AllowDrop="False" Style="{StaticResource CustomPasswordboxStyle}" LostFocus="Textbox_LostFocus"/>
            <Button x:Name="ConfirmButton" Content="???????????" HorizontalAlignment="Center" Margin="0,300,0,0" VerticalAlignment="Center" Width="186" Height="46" FontSize="21" FontFamily="Noto Sans JP Medium" Background="#FFC1C7D9" Foreground="#FF4679A6" Style="{StaticResource SmoothActiveButtonStyle}" Click="ConfirmButton_Click" IsEnabled="False"/>
            <Label x:Name="ErrorLabel" Content="???????: ????????" HorizontalAlignment="Center" Margin="0,404,0,0" VerticalAlignment="Center" FontSize="15" FontFamily="Noto Sans JP Light" Background="{x:Null}" Foreground="#FFF71818" Visibility="Hidden"/>
