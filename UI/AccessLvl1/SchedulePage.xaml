<Page x:Class="AppClient.UI.AccessLvl1.SchedulePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AppClient.UI.AccessLvl1"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1770"
      Title="SchedulePage" Background="Transparent" Unloaded="Page_Unloaded">

    <Grid>
        <Border Background="#C1C7D9" CornerRadius="30,0,0,30">
            <Grid>
                <Label Content="МАРШРУТ" HorizontalAlignment="Left" Margin="80,-900,0,0" VerticalAlignment="Center" FontSize="60" FontFamily="Noto Sans JP Black" Background="{x:Null}" Foreground="#0F398C"/>
                <Label x:Name="RouteLabel" Width="220" Content="Автобус №0" HorizontalAlignment="Left" Margin="80,-750,0,0" VerticalAlignment="Center" FontSize="28" FontFamily="Noto Sans JP Medium" Background="{x:Null}" Foreground="#0F398C"/>
             
                <Label x:Name="DepotLabel" Content="Автобусний парк №0" HorizontalAlignment="Left" Margin="340,-750,0,0" VerticalAlignment="Center" FontSize="28" FontFamily="Noto Sans JP Medium" Background="{x:Null}" Foreground="#0F398C"/>

                <Label Content="Транспортний засіб:" HorizontalAlignment="Left" Margin="700,-750,0,0" VerticalAlignment="Center" FontSize="28" FontFamily="Noto Sans JP Medium" Background="{x:Null}" Foreground="#0F398C"/>
                <Label x:Name="VehicleNameLabel" Width="370" HorizontalAlignment="Left" Margin="1000,-750,0,0" VerticalAlignment="Center" FontSize="28" FontFamily="Noto Sans JP Medium" Background="{x:Null}" Foreground="#0F398C">
                    <TextBlock Text="" TextWrapping="WrapWithOverflow"/>
                </Label>
                <Label x:Name="VehicleIdLabel" Content="АА0000АА" Width="280" HorizontalAlignment="Left" Margin="700,-650,0,0" VerticalAlignment="Center" FontSize="26" FontFamily="Noto Sans JP Black" Background="{x:Null}" Foreground="#0F398C" HorizontalContentAlignment="Right"/>
                
                <Label Content="Загальна довжина:" HorizontalAlignment="Left" Margin="80,-640,0,0" VerticalAlignment="Center" FontSize="26" FontFamily="Noto Sans JP Medium" Background="{x:Null}" Foreground="#0F398C"/>
                <Label x:Name="DistanceLabel" Content="0 км" HorizontalAlignment="Left" Margin="340,-640,0,0" VerticalAlignment="Center" FontSize="26" FontFamily="Noto Sans JP Medium" Background="{x:Null}" Foreground="#0F398C"/>

                <Label x:Name="LivetimeLabel" Content="00:00" HorizontalAlignment="Right" Margin="0,-900,80,0" VerticalAlignment="Center" FontSize="60" FontFamily="Noto Sans JP Black" Background="{x:Null}" Foreground="#0F398C"/>
                <Label x:Name="RemainingtimeInfoLabel" Visibility="Collapsed" Content="Залишається:" HorizontalAlignment="Right" Margin="0,-750,140,0" VerticalAlignment="Center" FontSize="28" FontFamily="Noto Sans JP Medium" Background="{x:Null}" Foreground="#0F398C"/>
                <Label x:Name="RemainingtimeLabel" Visibility="Collapsed" Content="0 хв." HorizontalAlignment="Right" Margin="0,-750,40,0" VerticalAlignment="Center" FontSize="28" FontFamily="Noto Sans JP Medium" Background="{x:Null}" Foreground="#0F398C"/>

                <Image x:Name="BackgroundImage" HorizontalAlignment="Right" Height="590" VerticalAlignment="Center" Width="50" Source="/UI/Resources/Images/route.png" Margin="0,220,320,0"/>
                <Label x:Name="RouteendLabel" HorizontalAlignment="Right" Margin="0,-250,20,0" Height="140" Width="300" VerticalAlignment="Center" FontSize="26" FontFamily="Noto Sans JP Medium" Background="{x:Null}" Foreground="#0F398C">
                    <TextBlock Text="Зупинка Б" TextWrapping="WrapWithOverflow"/>
                </Label>
                    <Label x:Name="RoutestartLabel" HorizontalAlignment="Right" Margin="0,856,20,0" Height="140" Width="300" VerticalAlignment="Center" FontSize="26" FontFamily="Noto Sans JP Medium" Background="{x:Null}" Foreground="#0F398C" ClipToBounds="True">
                    <TextBlock Text="Зупинка А" TextWrapping="WrapWithOverflow"/>
                </Label>
                <Label x:Name="RoutestopsLabel" Content="2 зупинок" HorizontalAlignment="Right" Margin="0,214,20,0" Width="300" VerticalAlignment="Center" FontSize="26" FontFamily="Noto Sans JP Medium" Background="{x:Null}" Foreground="#0F398C"/>

                <Grid Width="1280" Height="720" ClipToBounds="True" Margin="-20,250,300,50" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image x:Name="MapImage" 
                       Width="1280" 
                       Height="720" 
                       MaxWidth="1280" 
                       MaxHeight="720"                        
                       VerticalAlignment="Stretch" 
                       HorizontalAlignment="Stretch" 
                       Stretch="Uniform" 
                       ClipToBounds="True"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
