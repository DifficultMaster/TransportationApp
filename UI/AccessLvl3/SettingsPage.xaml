<Page x:Class="AppClient.UI.AccessLvl3.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AppClient.UI.AccessLvl3"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1770"
      Title="SettingsPage" Background="Transparent" Unloaded="Page_Unloaded">
    
    <Border Background="#C1C7D9" CornerRadius="30,0,0,30">
        <Grid>
            <Label Content="НАЛАШТУВАННЯ" HorizontalAlignment="Left" Margin="80,-900,0,0" VerticalAlignment="Center" FontSize="60" FontFamily="Noto Sans JP Black" Background="{x:Null}" Foreground="#0F398C"/>
            
            <Grid x:Name="ArchivationGrid">
                <Border Background="#0F398C" CornerRadius="20" Margin="60,278,945,40">
                    <Grid>
                        <Label Content="Архівація бази даних" HorizontalAlignment="Center" Margin="0,-400,0,0" VerticalAlignment="Center" FontSize="40" FontFamily="Noto Sans JP Black" Background="{x:Null}" Foreground="#C1C7D9"/>
                        <Label Content="                             УВАГА!&#x0A;  Після відновлення бази даних&#x0A;ЗМІНИ ВІДМІНИТИ НЕМОЖЛИВО!" HorizontalAlignment="Center" Margin="0,-100,0,0" VerticalAlignment="Center" FontSize="28" FontFamily="Noto Sans JP Medium" Background="{x:Null}" Foreground="#F71818"/>
                        <Button x:Name="DownloadButton" Content="Зберегти базу даних" HorizontalAlignment="Center" Margin="0,200,0,0" VerticalAlignment="Center" Width="300" Height="66" FontSize="21" FontFamily="Noto Sans JP Medium" Background="#FFC1C7D9" Foreground="#FF4679A6" Style="{StaticResource SmoothActiveButtonStyle}" Click="DownloadButton_Click" IsEnabled="True"/>
                        <Button x:Name="UploadButton" Content="Відновити базу даних" HorizontalAlignment="Center" Margin="0,450,0,0" VerticalAlignment="Center" Width="300" Height="66" FontSize="21" FontFamily="Noto Sans JP Medium" Background="#FFC1C7D9" Foreground="#FF4679A6" Style="{StaticResource SmoothActiveButtonStyle}" Click="UploadButton_Click" IsEnabled="True"/>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="TestGrid">
                <Border Background="#0F398C" CornerRadius="20" Margin="945,278,60,40">
                    <Grid>
                        <Label Content="Тестування швидкості" HorizontalAlignment="Center" Margin="0,-400,0,0" VerticalAlignment="Center" FontSize="40" FontFamily="Noto Sans JP Black" Background="{x:Null}" Foreground="#C1C7D9"/>
                        <Label Content="Будь ласка, введіть кількість записів нижче:" HorizontalAlignment="Center" Margin="0,-200,0,0" VerticalAlignment="Center" FontSize="28" FontFamily="Noto Sans JP Medium" Background="{x:Null}" Foreground="#C1C7D9"/>
                        <TextBox x:Name="TestTextbox" HorizontalAlignment="Center" Margin="0,50,0,0" TextWrapping="Wrap" VerticalAlignment="Center" Width="300" Height="48" FontSize="21" FontFamily="Noto Sans JP Medium" AllowDrop="False" Style="{StaticResource CustomTextboxStyle}" KeyDown="TestTextbox_KeyDown"/>
                        <Label x:Name="TestLabel" Content="Час виконання 0 записів: 0 секунд" HorizontalAlignment="Center" Margin="0,200,0,0" VerticalAlignment="Center" FontSize="28" FontFamily="Noto Sans JP Black" Background="{x:Null}" Foreground="#C1C7D9"/>
                        <Button x:Name="TestButton" Content="Почати тест" HorizontalAlignment="Center" Margin="0,450,0,0" VerticalAlignment="Center" Width="200" Height="66" FontSize="21" FontFamily="Noto Sans JP Medium" Background="#FFC1C7D9" Foreground="#FF4679A6" Style="{StaticResource SmoothActiveButtonStyle}" Click="TestButton_Click" IsEnabled="True"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Page>
