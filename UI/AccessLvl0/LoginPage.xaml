<Page x:Name="LoginPage1" x:Class="AppClient.UI.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d" 
      d:DesignHeight="960" d:DesignWidth="600"
      Title="LoginPage" Background="#FF0F398C">

    <Grid>
        <Image Source="/UI/Resources/Images/Backgrounds/kyivmetro.jpg" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.31" MouseDown="Image_MouseDown" >
            <Image.Effect>
                <BlurEffect Radius="21" RenderingBias="Performance" KernelType="Gaussian"/>
            </Image.Effect>
        </Image>
        <Button x:Name="KeyboardButton" HorizontalAlignment="Left" Height="22" Margin="8,8,0,0" VerticalAlignment="Top" Width="22" Style="{StaticResource SmoothActiveButtonStyle}" Click="KeyboardButton_Click">
            <Button.Background>
                <ImageBrush ImageSource="/UI/Resources/Images/keyboardIcon.png"/>
            </Button.Background>
        </Button>
        <Label Content="Вітаємо!" HorizontalAlignment="Center" Margin="0,-450,0,0" VerticalAlignment="Center" FontSize="60" FontFamily="Noto Sans JP Black" Background="{x:Null}" Foreground="#FFC1C7D9"/>

        <Grid Margin="0,400,0,0" Width="465" Height="450" Background="#FF4679A6" Opacity="0.90" MouseDown="Image_MouseDown">
            <Grid.Clip>
                <RectangleGeometry RadiusX="20" RadiusY="20" Rect="0,0,465,450"/>
            </Grid.Clip>
            <Label Content="Введіть дані для входу:" HorizontalAlignment="Center" Margin="0,-300,0,0" VerticalAlignment="Center" FontSize="27" FontFamily="Noto Sans JP Medium" Background="{x:Null}" Foreground="#FFC1C7D9"/>
            <Label Content="Логін" HorizontalAlignment="Center" Margin="-256,-135,0,0" VerticalAlignment="Center" FontSize="16" FontFamily="Noto Sans JP Light" Background="{x:Null}" Foreground="#FFC1C7D9"/>
            <TextBox x:Name="LoginTextbox" HorizontalAlignment="Center" Margin="0,-75,0,0" TextWrapping="Wrap" VerticalAlignment="Center" Width="300" Height="38" FontSize="14" FontFamily="Noto Sans JP Medium" AllowDrop="False" Style="{StaticResource CustomTextboxStyle}" LostFocus="Textbox_LostFocus"/>
            <CheckBox x:Name="IsTerminalModeCheckbox" HorizontalAlignment="Center" Margin="-160,-15,0,0" VerticalAlignment="Center" Content="Зайти в режимі терміналу" FontSize="10" FontFamily="Noto Sans JP Light" Foreground="#FFC1C7D9">
                <CheckBox.RenderTransform>
                    <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                </CheckBox.RenderTransform>
            </CheckBox>
            <Label Content="Пароль" HorizontalAlignment="Center" Margin="-240,90,0,0" VerticalAlignment="Center" FontSize="16" FontFamily="Noto Sans JP Light" Background="{x:Null}" Foreground="#FFC1C7D9"/>
            <PasswordBox x:Name="PasswordTextbox" HorizontalAlignment="Center" Margin="0,150,0,0" VerticalAlignment="Center" Width="300" Height="38" FontSize="14" FontFamily="Noto Sans JP Medium" AllowDrop="False" Style="{StaticResource CustomPasswordboxStyle}" LostFocus="Textbox_LostFocus"/>
            <Button x:Name="LoginButton" Content="Увійти" HorizontalAlignment="Center" Margin="150,300,0,0" VerticalAlignment="Center" Width="136" Height="46" FontSize="21" FontFamily="Noto Sans JP Medium" Background="#FFC1C7D9" Foreground="#FF4679A6" Style="{StaticResource SmoothActiveButtonStyle}" Click="LoginButton_Click" IsEnabled="False"/>
            <Button x:Name="RegisterButton" Content="Реєстрація" HorizontalAlignment="Center" Margin="-150,300,0,0" VerticalAlignment="Center" Width="136" Height="46" FontSize="21" FontFamily="Noto Sans JP Medium" Background="#FFC1C7D9" Foreground="#FF4679A6" Style="{StaticResource SmoothActiveButtonStyle}" Click="RegisterButton_Click" IsEnabled="False"/>
            <Label x:Name="ErrorLabel" Content="Помилка: невідома" HorizontalAlignment="Center" Margin="0,404,0,0" VerticalAlignment="Center" FontSize="15" FontFamily="Noto Sans JP Light" Background="{x:Null}" Foreground="#FFF71818" Visibility="Hidden"/>
        </Grid>
    </Grid>
</Page>
